    "NSFaceIDUsageDescription" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID schützt die Anmeldung im Povod-Dashboard auf diesem Telefon."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID protects sign-in to your Povod dashboard on this phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID protege el acceso a tu panel de Povod en este teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID protège l’accès à votre espace client Povod sur ce téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID protegge l'accesso all'area personale di Povod su questo telefono."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID chroni logowanie do panelu Povod na tym telefonie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
