    "%@ больше не сможет войти в кабинет. Компании, которые он вёл, останутся." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kann sich nicht mehr im Dashboard anmelden. Die betreuten Firmen bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ will no longer be able to sign in to the dashboard. The companies they handled will stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya no podrá entrar en el panel. Las empresas que llevaba se quedarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne pourra plus se connecter à l’espace client. Les entreprises qu’il suivait resteront."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non potrà più accedere all'area personale. Le aziende che seguiva resteranno."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nie będzie mógł już wejść do panelu. Firmy, które prowadził, zostaną."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não poderá mais entrar no painel. As empresas que ele acompanhava continuarão lá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ больше не сможет войти в кабинет. Компании, которые он вёл, останутся."
          }
        }
      }
    },
