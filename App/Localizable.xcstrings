    "выберите компании и нажмите «в рассылку» — письма уйдут сами, в рабочие часы" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmen auswählen und auf „ins Mailing“ tippen — E-Mails gehen automatisch zu Geschäftszeiten raus"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "select companies and tap “add to campaign” — emails go out on their own during working hours"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "elige empresas y pulsa «a campaña»: los correos se envían solos, en horario laboral"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "choisissez des entreprises et touchez « vers une campagne » — les e-mails partent seuls, aux heures ouvrées"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "seleziona le aziende e tocca “alla campagna” — le email partono da sole, in orario lavorativo"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "wybierz firmy i naciśnij „do wysyłki” — maile wyjdą same, w godzinach pracy"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "selecione empresas e toque em “para campanha” — os e-mails saem sozinhos, em horário comercial"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "выберите компании и нажмите «в рассылку» — письма уйдут сами, в рабочие часы"
          }
        }
      }
    },
