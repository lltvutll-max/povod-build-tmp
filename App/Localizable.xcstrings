    "База получателей и история писем сохранятся. Сразу после удаления можно нажать «отменить»." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empfängerliste und E-Mail-Verlauf bleiben erhalten. Direkt nach dem Löschen können Sie auf „rückgängig“ tippen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The recipient list and email history are kept. Right after deleting you can tap “undo”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lista de destinatarios y el historial de correos se conservan. Justo después de eliminar podrás pulsar «deshacer»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La liste des destinataires et l'historique des e-mails sont conservés. Juste après la suppression, vous pourrez appuyer sur « annuler »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'elenco dei destinatari e la cronologia delle email restano. Subito dopo l'eliminazione potrai toccare «annulla»."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lista odbiorców i historia wiadomości zostaną zachowane. Zaraz po usunięciu możesz stuknąć „cofnij”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lista de destinatários e o histórico de e-mails ficam guardados. Logo após apagar pode tocar em «anular»."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "База получателей и история писем сохранятся. Сразу после удаления можно нажать «отменить»."
          }
        }
      }
    },
