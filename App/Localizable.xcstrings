    "выбрано: %@. Sguardo проверит номера в WhatsApp и напишет первым — по одной компании, с паузами и дневным лимитом" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ausgewählt: %@. Sguardo prüft die Nummern in WhatsApp und schreibt zuerst — Firma für Firma, mit Pausen und Tageslimit"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "selected: %@. Sguardo will check the numbers on WhatsApp and message first — one company at a time, with pauses and a daily limit"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "seleccionadas: %@. Sguardo comprobará los números en WhatsApp y escribirá primero: de una en una, con pausas y un límite diario"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "sélection : %@. Sguardo vérifiera les numéros sur WhatsApp et écrira en premier — une entreprise à la fois, avec des pauses et une limite quotidienne"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "selezionate: %@. Sguardo verificherà i numeri su WhatsApp e scriverà per primo — un'azienda alla volta, con pause e limite giornaliero"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "wybrano: %@. Sguardo sprawdzi numery w WhatsApp i napisze pierwsze — po jednej firmie, z przerwami i dziennym limitem"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "selecionadas: %@. O Sguardo vai verificar os números no WhatsApp e escrever primeiro — uma empresa por vez, com pausas e limite diário"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "выбрано: %@. Sguardo проверит номера в WhatsApp и напишет первым — по одной компании, с паузами и дневным лимитом"
          }
        }
      }
    },
