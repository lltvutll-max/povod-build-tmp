    "%@. подключите WhatsApp в Sguardo, чтобы сообщения ушли" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. verbinden Sie WhatsApp in Sguardo, damit die Nachrichten rausgehen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. connect WhatsApp in Sguardo so the messages go out"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. conecta WhatsApp en Sguardo para que se envíen los mensajes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. connectez WhatsApp dans Sguardo pour envoyer les messages"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. collega WhatsApp in Sguardo per inviare i messaggi"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. podłącz WhatsApp w Sguardo, żeby wiadomości wyszły"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. conecte o WhatsApp no Sguardo para enviar as mensagens"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. подключите WhatsApp в Sguardo, чтобы сообщения ушли"
          }
        }
      }
    },
    "%@. рассылка на паузе — запустите её в разделе «почта»" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. das Mailing ist pausiert — starten Sie es im Bereich „E-Mail“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. the campaign is paused — start it in the “email” section"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. la campaña está en pausa: lánzala en la sección «correo»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. la campagne est en pause — lancez-la dans la section « e-mail »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. la campagna è in pausa — avviala nella sezione “email”"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. wysyłka jest wstrzymana — uruchom ją w sekcji „poczta”"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. a campanha está em pausa — inicie-a na seção “e-mail”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. рассылка на паузе — запустите её в разделе «почта»"
          }
        }
      }
    },
