        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "aún no hay señales: llegarán cuando algo pase en una empresa de tus selecciones, como que se caiga su web o reciba malas reseñas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "aucun signal pour l’instant — ils arrivent quand il se passe quelque chose chez une entreprise de vos sélections : site en panne, mauvais avis"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ancora nessun segnale — arriveranno quando succede qualcosa alle aziende delle selezioni: il sito va giù, arrivano recensioni negative"
