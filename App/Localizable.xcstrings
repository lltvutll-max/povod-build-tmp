          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviamos 6 dígitos para %@. O e-mail pode levar até um minuto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправили 6 цифр на %@. Письмо может идти до минуты."
