    "Компании не удалятся — вернутся в папки своих подборок." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmen werden nicht gelöscht — sie kehren in die Ordner ihrer Auswahlen zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Companies won’t be deleted — they’ll return to their segments’ folders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las empresas no se eliminan: vuelven a las carpetas de sus selecciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les entreprises ne seront pas supprimées — elles retournent dans les dossiers de leurs sélections."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le aziende non verranno eliminate: torneranno nelle cartelle delle loro selezioni."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firmy nie zostaną usunięte — wrócą do folderów swoich wyszukiwań."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As empresas não serão excluídas — voltarão para as pastas das suas seleções."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Компании не удалятся — вернутся в папки своих подборок."
          }
        }
      }
    },
    "Компания пропадёт из списков. Ещё 9 секунд можно будет нажать «отменить»." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Firma verschwindet aus den Listen. 9 Sekunden lang können Sie noch auf „rückgängig“ tippen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The company will disappear from your lists. You’ll have 9 seconds to tap “undo”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La empresa desaparecerá de las listas. Durante 9 segundos aún podrás pulsar «deshacer»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’entreprise disparaîtra des listes. Pendant 9 secondes, vous pourrez encore toucher « annuler »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'azienda sparirà dagli elenchi. Per altri 9 secondi potrai toccare “annulla”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Firma zniknie z list. Przez 9 sekund będzie można nacisnąć „cofnij”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A empresa vai sumir das listas. Por mais 9 segundos dá para tocar em “desfazer”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Компания пропадёт из списков. Ещё 9 секунд можно будет нажать «отменить»."
